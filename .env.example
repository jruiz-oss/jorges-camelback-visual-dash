# Copy this to .env.local for local dev. In production these live on the
# Railway "web" service (and the Vercel project, if it's still running).
# See DEPLOY.md.

# ─── Global — shared across ALL clients ──────────────────────────────────────

# Random secret used to HMAC-sign all auth cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASHBOARD_AUTH_SECRET=

# Admin PIN for edit mode (server-side only, applies to all clients)
ADMIN_PIN=

# ─── Redis (shared admin settings, ad filter, goals, rate limiting) ─────────
# Railway: ${{Redis.REDIS_URL}}. Vercel / local: the Redis public URL.
REDIS_URL=
# Fallback only (Upstash HTTP API) — used when REDIS_URL is not set:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Optional: max total auth attempts across ALL IPs per 15 min (default 60).
RATE_LIMIT_GLOBAL_MAX=

# Meta system user token — same across all ad accounts
META_ACCESS_TOKEN=

# Google Ads — developer token + service account (same for all clients)
GOOGLE_DEVELOPER_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=   # full JSON key file content, one line
GOOGLE_LOGIN_CUSTOMER_ID=      # MCC account ID (e.g. 123-456-7890)
# GOOGLE_ADS_API_VERSION=v25   # optional: pin instead of auto-detect

# ─── Per-client — one block per client dashboard ─────────────────────────────

# Client: Camelback Resort  →  /camelback
CAMELBACK_PASSWORD=yourpasswordhere
CAMELBACK_META_AD_ACCOUNT_ID=act_123456789   # the bare number works too
CAMELBACK_GOOGLE_CUSTOMER_ID=   # 10-digit customer ID, no dashes
CAMELBACK_STACKADAPT_API_KEY=   # account-wide; other clients reuse it
CAMELBACK_STACKADAPT_ADVERTISER_ID=   # numeric advertiser ID — scopes results to this client (the server log lists them all once per start)

# Optional per-client defaults. Admins can override both from the footer
# (saved in Redis for every viewer); these apply until they do.
#   CAMELBACK_AD_FILTER=meta: +Commit, -Awestruck | google: +Commit
#   CAMELBACK_VIEW_MODE=channel

# Client: (example second client)  →  /client2
# CLIENT2_PASSWORD=
# CLIENT2_META_AD_ACCOUNT_ID=act_
# CLIENT2_GOOGLE_CUSTOMER_ID=
# CLIENT2_STACKADAPT_ADVERTISER_ID=   # every value in this block must differ from other clients'
