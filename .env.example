# Copy this to .env.local for local dev, then add all vars to Vercel Environment Variables

# ─── Global — shared across ALL clients ──────────────────────────────────────

# Random secret used to HMAC-sign all auth cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASHBOARD_AUTH_SECRET=

# Admin PIN for the segment-rename lock (server-side only, applies to all clients)
ADMIN_PIN=

# ─── Upstash Redis (admin performance goals + rate limiting) ─────────────────
# Stores the admin account/campaign performance goals, and makes the auth +
# admin-unlock rate limit hold across Vercel instances (in-memory otherwise).
# Either pair works (lib/kv.ts reads both):
#   - Vercel → Storage → Upstash for Redis injects KV_REST_API_URL/KV_REST_API_TOKEN
#   - or create a DB at https://upstash.com and set the UPSTASH_* pair
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: max total auth attempts across ALL IPs per 15 min (default 60).
# Raise if you have many legitimate users; lower to tighten brute-force defense.
RATE_LIMIT_GLOBAL_MAX=

# Meta system user token — same across all ad accounts (MCC/system user)
META_ACCESS_TOKEN=

# Google Ads — MCC developer token + OAuth app credentials (same for all clients)
GOOGLE_DEVELOPER_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_LOGIN_CUSTOMER_ID=   # MCC account ID (e.g. 123-456-7890), leave blank if not using MCC

# ─── Per-client — one block per client dashboard ─────────────────────────────

# Client: Camelback Resort  →  /camelback
CAMELBACK_PASSWORD=yourpasswordhere
CAMELBACK_META_AD_ACCOUNT_ID=act_123456789
CAMELBACK_GOOGLE_CUSTOMER_ID=   # 10-digit customer ID, no dashes
CAMELBACK_STACKADAPT_API_KEY=
CAMELBACK_STACKADAPT_ADVERTISER_ID=   # numeric advertiser ID — scopes results to this client (StackAdapt → Settings → Advertiser, or the server log lists them all)

# Optional per-client ad filter (+ = show only, - = hide, | separates platforms):
#   CAMELBACK_AD_FILTER=meta: +Commit, -Awestruck | google: +Commit
#   CAMELBACK_AD_FILTER=+Commit, -Awestruck        (all platforms)

# Optional per-client default layout for every visitor: segment (default) or channel
# (Meta / Google Ads / StackAdapt sections, no segments). Admins can also flip it
# from the footer "View" button, but that only changes their own browser.
#   CAMELBACK_VIEW_MODE=channel

# Client: (example second client)  →  /client2
# CLIENT2_PASSWORD=
# CLIENT2_META_AD_ACCOUNT_ID=act_
# CLIENT2_GOOGLE_CUSTOMER_ID=
# CLIENT2_STACKADAPT_API_KEY=
# CLIENT2_STACKADAPT_ADVERTISER_ID=   # REQUIRED with the key above. Every value in this block must differ from other clients'.

# ─── Google OAuth re-auth (enables one-click token refresh from the dashboard) ─
# Create a personal access token at https://vercel.com/account/tokens with
# "Full Account" scope. VERCEL_PROJECT_ID is injected automatically by Vercel.
VERCEL_API_TOKEN=
